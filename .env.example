# Frontend: values prefixed with VITE_ are embedded in the browser bundle.
VITE_API_URL=http://localhost:4000
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_WS_URL=ws://localhost:4000/graphql

# Backend: server-only values. Never expose these through VITE_* variables.
API_URL=http://localhost:4000
COOKIE_SAME_SITE=lax
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:5174
GUEST_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
# Optional invitation email delivery through Resend.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your-server-only-key
# INVITATION_EMAIL_FROM=Boardnest <invites@your-verified-domain.example>
# Or use any SMTP provider. SMTP is also required by the notification delivery
# worker. For Gmail, SMTP_PASSWORD must be a Google App Password, not the
# normal account password.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-google-app-password
# INVITATION_EMAIL_FROM=Boardnest <your-address@gmail.com>
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_INTERVAL_MS=30000
REMINDER_SCHEDULER_BATCH_SIZE=100
EMAIL_DELIVERY_WORKER_ENABLED=false
EMAIL_DELIVERY_WORKER_INTERVAL_MS=15000
EMAIL_DELIVERY_WORKER_BATCH_SIZE=25
TRUST_PROXY_HOPS=0
NODE_ENV=development

# Required for account deletion, the reminder scheduler, and the email delivery
# worker. Keep this server-side and never expose it through a VITE_* variable.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-server-only-key
# Reserved administration value (not read by the application runtime).
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Docker Compose host-facing configuration. These values are not secrets.
API_HOST_PORT=4000
WEB_HOST_PORT=8080
REDIS_HOST_PORT=6379
DOCKER_API_URL=http://localhost:4000
DOCKER_COOKIE_SAME_SITE=lax
DOCKER_WEB_ORIGIN=http://localhost:8080
DOCKER_NODE_ENV=development
DOCKER_PUBLIC_API_URL=http://localhost:4000
DOCKER_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
DOCKER_PUBLIC_WS_URL=ws://localhost:4000/graphql
