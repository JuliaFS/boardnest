# Frontend: values prefixed with VITE_ are embedded in the browser bundle.
VITE_API_URL=http://localhost:4000
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_WS_URL=ws://localhost:4000/graphql

# Backend: server-only values. Never expose these through VITE_* variables.
API_URL=http://localhost:4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Docker Compose host-facing configuration. These values are not secrets.
API_HOST_PORT=4000
WEB_HOST_PORT=8080
REDIS_HOST_PORT=6379
DOCKER_API_URL=http://localhost:4000
DOCKER_WEB_ORIGIN=http://localhost:8080
DOCKER_NODE_ENV=development
DOCKER_PUBLIC_API_URL=http://localhost:4000
DOCKER_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
DOCKER_PUBLIC_WS_URL=ws://localhost:4000/graphql
