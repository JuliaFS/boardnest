{
  "name": "@boardnest/mobile",
  "version": "0.1.0",
  "description": "Boardnest mobile client built with Expo and React Native",
  "main": "expo-router/entry",
  "dependencies": {
    "@apollo/client": "4.3.1",
    "@boardnest/graphql-types": "workspace:*",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "build": "expo export --platform web --output-dir dist",
    "ios": "expo start --ios",
    "test": "pnpm test:unit && pnpm test:components",
    "test:components": "jest --ci --runInBand",
    "test:components:coverage": "jest --ci --runInBand --coverage",
    "test:unit": "vitest run",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "private": true
}
