{
  "name": "@boardnest/mobile",
  "version": "0.1.0",
  "description": "Boardnest mobile client built with Expo and React Native",
  "main": "expo-router/entry",
  "dependencies": {
    "@apollo/client": "4.3.1",
    "@boardnest/graphql-types": "workspace:*",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "graphql": "^16.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "build": "expo export --platform web --output-dir dist",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "private": true
