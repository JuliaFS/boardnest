{
  "name": "boardnest",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time, multi-tenant project management platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "dev": "pnpm --parallel --filter @boardnest/api --filter @boardnest/web dev",
    "docker:build": "docker compose build",
    "docker:config": "docker compose config",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web redis",
    "docker:up": "docker compose up -d --build --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "redis:down": "docker compose stop redis",
    "redis:logs": "docker compose logs -f redis",
    "redis:up": "docker compose up -d --wait redis",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test": "pnpm --recursive --if-present test",
    "test:ci": "pnpm --filter @boardnest/shared test && pnpm --filter @boardnest/api --filter @boardnest/web --parallel test:coverage",
    "test:coverage": "pnpm --filter @boardnest/api --filter @boardnest/web --parallel test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
